{
  "manifest_version": 3,
  "name": "PushBox (בטא 4.65)",
  "version": "4.65",
  "description": "פושבוקס בטא 4.65 - מבוסס על גרסה 4.6 היציבה עם שיפורי מהירות, זיכרון מטמון ותיקוני תשתית.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.call2all.co.il/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html"
}
